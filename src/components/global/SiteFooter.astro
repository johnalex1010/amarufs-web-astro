---
import { site } from "../../data/site";
---

<footer class="site-footer">
  <div class="site-footer__main">
    <section class="site-footer__brand" aria-labelledby="footer-brand-title">
      <img class="site-footer__logo" src={site.logoVertical} alt="Amaru FS Inmobiliaria" width="120" height="120" />
      <div>
        <p id="footer-brand-title" class="site-footer__title">Amaru FS Inmobiliaria</p>
        <p class="site-footer__description">Tu aliado en arriendos, ventas y administración de inmuebles en Bogotá y Sabana.</p>
      </div>
    </section>

    <nav class="site-footer__column" aria-labelledby="footer-links-title">
      <h2 id="footer-links-title">Enlaces rápidos</h2>
      <ul class="site-footer__links">
        <li><a href="/"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i> Inicio</a></li>
        <li><a href="/propietarios/"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i> Propietarios</a></li>
        <li><a href="/propietarios/arriendo/"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i> Arrendar</a></li>
        <li><a href="/propietarios/venta/"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i> Vender</a></li>
        <li><a href="/inmuebles/"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i> Inmuebles</a></li>
      </ul>
    </nav>

    <section class="site-footer__column" aria-labelledby="footer-contact-title">
      <h2 id="footer-contact-title">Contáctanos</h2>
      <ul class="site-footer__contact-list">
        <li>
          <a class="site-footer__contact" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">
            <span class="site-footer__contact-icon"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i></span>
            <span><span class="site-footer__contact-label">WhatsApp</span><strong>{site.phoneLabel}</strong></span>
          </a>
        </li>
        <li>
          <span class="site-footer__contact">
            <span class="site-footer__contact-icon"><i class="fa-solid fa-location-dot" aria-hidden="true"></i></span>
            <span><span class="site-footer__contact-label">Cobertura</span><strong>Bogotá y Sabana</strong></span>
          </span>
        </li>
        <li>
          <a class="site-footer__contact" href="mailto:solicitudes@amarufs.co">
            <span class="site-footer__contact-icon"><i class="fa-regular fa-envelope" aria-hidden="true"></i></span>
            <span><span class="site-footer__contact-label">Escríbenos</span><strong>solicitudes@amarufs.co</strong></span>
          </a>
        </li>
      </ul>
    </section>

    <section class="site-footer__column site-footer__social-column" aria-labelledby="footer-social-title">
      <h2 id="footer-social-title">Síguenos</h2>
      <p class="site-footer__social-copy">Conoce nuestras novedades, propiedades y consejos en redes sociales.</p>
      <nav class="site-footer__social" aria-label="Redes sociales">
        <a href="https://www.instagram.com/amarufsco/" target="_blank" rel="noopener noreferrer" aria-label="Instagram de Amaru FS" title="Instagram de Amaru FS">
          <i class="fa-brands fa-instagram" aria-hidden="true"></i>
        </a>
        <a href="https://www.facebook.com/amarufsco" target="_blank" rel="noopener noreferrer" aria-label="Facebook de Amaru FS" title="Facebook de Amaru FS">
          <i class="fa-brands fa-facebook-f" aria-hidden="true"></i>
        </a>
      </nav>
    </section>

    <a class="site-footer__back-to-top" href="#inicio">
      <span class="site-footer__back-to-top-icon"><i class="fa-solid fa-chevron-up" aria-hidden="true"></i></span>
      <span>Volver arriba</span>
    </a>
  </div>

  <div class="site-footer__bottom">
    <p>© 2026 Amaru FS Inmobiliaria. Todos los derechos reservados.</p>
  </div>
</footer>
