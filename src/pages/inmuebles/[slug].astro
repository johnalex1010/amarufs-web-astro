---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ClosingCta from "../../components/sections/ClosingCta.astro";
import FaqSection, { type FaqItem } from "../../components/sections/FaqSection.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import Button from "../../components/ui/Button.astro";
import RentalRequirementsModal from "../../components/common/RentalRequirementsModal.astro";
import { site } from "../../data/site";
import { getPublishedProperties, getPublishedPropertyBySlug } from "../../lib/properties";
import {
  extractGoogleMapsSrc,
  formatCurrency,
  getCroppedImageUrl,
  getFeatureIconClass,
  getImageSrcset,
  getMapCoordinates,
  getOptimizedImageUrl,
  getOperationLabel,
  getPhotoAlt,
  getPriceLabel,
  getPropertyAnswerSummary,
  getPropertyFacts,
  getPropertyHeading,
  getPropertyPrices,
  includesRent,
  includesSale,
  getPropertyHref,
  getPropertyLocationLabel,
  getPropertyPlaceLabel,
  getPropertyPostalAddress,
  getPropertyPrice,
  getPropertyTypeLabel,
  getPropertyUrl,
  getPropertyWhatsappHref,
  getRelatedProperties,
  getSocialImageUrl,
  getYoutubeEmbedSrc,
  renderRichText
} from "../../lib/property-utils";
import "../../styles/pages/detalle-inmueble.css";

export async function getStaticPaths() {
  const properties = await getPublishedProperties();
  return properties.map((property) => ({
    params: { slug: property.slug }
  }));
}

const { slug } = Astro.params;
const property = slug ? await getPublishedPropertyBySlug(slug) : undefined;
const allProperties = await getPublishedProperties();

if (!property) {
  return Astro.redirect("/inmuebles/");
}

const price = getPropertyPrice(property);
const formattedPrice = formatCurrency(price);
const descriptionHtml = renderRichText(property.description);
const mapsSrc = extractGoogleMapsSrc(property.googleMapsEmbed);
const youtubeSrc = getYoutubeEmbedSrc(property.youtubeShortUrl);
const whatsappHref = getPropertyWhatsappHref(property);
const isRent = includesRent(property.operation);
const isSale = includesSale(property.operation);
const isDual = isRent && isSale;
const prices = getPropertyPrices(property);
const operationLabel = getOperationLabel(property.operation);
const priceLabel = getPriceLabel(property.operation);
const getGalleryImageAlt = (index: number) => getPhotoAlt(property, property.gallery[index], index);
const galleryWidths = [480, 768, 1080, 1440];
const gallerySizes = "(max-width: 1180px) 100vw, 66vw";
const galleryImages = property.gallery.map((photo, index) => ({
  ...photo,
  alt: getGalleryImageAlt(index),
  mainSrc: getCroppedImageUrl(photo.src, 1080),
  srcset: getImageSrcset(photo.src, galleryWidths, getCroppedImageUrl),
  thumbSrc: getCroppedImageUrl(photo.src, 240, "1:1"),
  modalSrc: getOptimizedImageUrl(photo.src, 1600)
}));
const mainImage = galleryImages[0];
const propertyUrl = getPropertyUrl(property);
const propertyHeading = getPropertyHeading(property);
const answerSummary = getPropertyAnswerSummary(property);
const propertyTypeLabel = getPropertyTypeLabel(property.propertyType);
const typeArticle = ["casa", "bodega", "oficina", "finca"].includes(property.propertyType.toLowerCase()) ? "de la" : "del";
const featuresTitle = `Características ${typeArticle} ${propertyTypeLabel.toLowerCase()} en ${getPropertyPlaceLabel(property)}`;
const relatedProperties = getRelatedProperties(property, allProperties);
const facts = getPropertyFacts(property);
const coordinates = getMapCoordinates(mapsSrc);
const processTitle = isDual
  ? "Cómo avanzar si quieres tomar en arriendo o comprar este inmueble"
  : isRent
  ? "Cómo avanzar si quieres tomar en arriendo este inmueble"
  : "Cómo avanzar si quieres comprar este inmueble";
const processSteps = isRent
  ? [
      {
        icon: "fa-brands fa-whatsapp",
        title: "Consulta disponibilidad",
        text: "Escríbenos por WhatsApp con el nombre o código del inmueble."
      },
      {
        icon: "fa-solid fa-images",
        title: "Revisa fotos y características",
        text: "Confirmamos información disponible para que decidas si quieres continuar."
      },
      {
        icon: "fa-solid fa-list-check",
        title: "Solicita requisitos",
        text: "Si el inmueble te interesa, te compartimos los requisitos necesarios para iniciar el proceso.",
        modalId: "detail-requirements-modal",
        actionLabel: "Ver requisitos"
      },
      {
        icon: "fa-solid fa-file-shield",
        title: "Estudio de aseguradora",
        text: "La aseguradora, no Amaru FS Inmobiliaria, realiza el estudio del interesado y su deudor."
      },
      {
        icon: "fa-solid fa-file-signature",
        title: "Contrato",
        text: "Si el proceso avanza correctamente, se realiza el contrato de arrendamiento."
      }
    ]
  : [
      {
        icon: "fa-brands fa-whatsapp",
        title: "Consulta disponibilidad",
        text: "Escríbenos por WhatsApp con el nombre o código del inmueble."
      },
      {
        icon: "fa-solid fa-images",
        title: "Revisa fotos y características",
        text: "Validamos la información disponible para que decidas si quieres conocer más."
      },
      {
        icon: "fa-solid fa-calendar-check",
        title: "Agenda una visita",
        text: "Coordinamos la visita según disponibilidad del inmueble y autorización del propietario."
      },
      {
        icon: "fa-solid fa-handshake",
        title: "Presenta interés",
        text: "Si quieres avanzar, se revisan condiciones comerciales y pasos documentales.",
        modalId: "sale-requirements-modal",
        actionLabel: "Ver requisitos"
      },
      {
        icon: "fa-solid fa-file-signature",
        title: "Cierre",
        text: "Si las partes avanzan correctamente, se formaliza el proceso con los documentos correspondientes."
      }
    ];
const faqItems: FaqItem[] = [
  {
    question: "¿El inmueble sigue disponible?",
    answer:
      "La disponibilidad debe confirmarse por WhatsApp, porque puede cambiar según visitas, solicitudes y avances del proceso."
  },
  {
    question: "¿Puedo pedir más fotos o videos?",
    answer:
      "Sí. Si hay material adicional disponible, Amaru FS Inmobiliaria puede compartirlo por WhatsApp o llamada."
  },
  {
    question: isRent ? "¿Quién realiza el estudio si quiero arrendar?" : "¿Puedo agendar una visita?",
    answer: isRent
      ? "La aseguradora realiza el estudio de viabilidad del interesado y su deudor. Amaru FS Inmobiliaria acompaña la información inicial y la coordinación comercial."
      : "Sí, si el inmueble está disponible y las condiciones permiten avanzar. La visita debe coordinarse con Amaru FS Inmobiliaria vía WhatsApp."
  },
  {
    question: "¿El precio publicado puede cambiar?",
    answer:
      "El precio debe estar confirmado antes de publicarse, pero puede cambiar si el propietario actualiza condiciones. Se recomienda confirmar por WhatsApp."
  },
  {
    question: "¿Qué información debo enviar por WhatsApp?",
    answer:
      "Envía el nombre o enlace del inmueble, tu interés principal y las dudas que quieras resolver antes de avanzar."
  }
];
const schemaTypeByProperty: Record<string, string> = {
  apartamento: "Apartment",
  apartaestudio: "Apartment",
  casa: "SingleFamilyResidence",
  lote: "Place"
};
const residenceType = schemaTypeByProperty[property.propertyType.toLowerCase()] ?? "Accommodation";
const isAccommodation = residenceType !== "Place";
const organizationId = `${site.baseUrl}#organizacion`;
const offerNodes = prices.map((item) => {
  const isRentOffer = item.kind === "arriendo";

  return {
    "@type": "Offer",
    "@id": `${propertyUrl}#oferta${isDual ? `-${item.kind}` : ""}`,
    url: propertyUrl,
    price: item.value,
    priceCurrency: "COP",
    availability: "https://schema.org/InStock",
    businessFunction: isRentOffer ? "http://purl.org/goodrelations/v1#LeaseOut" : "http://purl.org/goodrelations/v1#Sell",
    ...(isRentOffer
      ? {
          priceSpecification: {
            "@type": "UnitPriceSpecification",
            price: item.value,
            priceCurrency: "COP",
            unitCode: "MON",
            unitText: "mes",
            ...(property.administrationIncluded ? { description: "Administración incluida" } : {})
          }
        }
      : {}),
    itemOffered: { "@id": `${propertyUrl}#inmueble` },
    offeredBy: { "@id": organizationId }
  };
});
const detailJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "RealEstateListing",
      "@id": `${propertyUrl}#anuncio`,
      url: propertyUrl,
      name: property.title,
      description: property.metaDescription || answerSummary,
      inLanguage: site.locale,
      image: galleryImages.map((photo) => photo.modalSrc),
      ...(property.publishedAt ? { datePosted: property.publishedAt } : {}),
      ...(property.updatedAt ? { dateModified: property.updatedAt } : {}),
      about: { "@id": `${propertyUrl}#inmueble` },
      mainEntity: offerNodes.length === 1 ? { "@id": offerNodes[0]["@id"] } : offerNodes.map((offer) => ({ "@id": offer["@id"] })),
      breadcrumb: { "@id": `${propertyUrl}#migas` },
      ...(property.internalCode ? { identifier: property.internalCode } : {})
    },
    {
      "@type": residenceType,
      "@id": `${propertyUrl}#inmueble`,
      name: propertyHeading,
      description: property.description,
      image: mainImage.modalSrc,
      address: getPropertyPostalAddress(property),
      ...(coordinates ? { geo: { "@type": "GeoCoordinates", ...coordinates } } : {}),
      ...(isAccommodation && facts.area
        ? { floorSize: { "@type": "QuantitativeValue", value: facts.area, unitCode: "MTK", unitText: "m²" } }
        : {}),
      ...(!isAccommodation && facts.area
        ? { additionalProperty: { "@type": "PropertyValue", name: "Área del lote", value: facts.area, unitCode: "MTK", unitText: "m²" } }
        : {}),
      ...(isAccommodation && facts.bedrooms ? { numberOfBedrooms: facts.bedrooms } : {}),
      ...(isAccommodation && facts.bathrooms ? { numberOfBathroomsTotal: facts.bathrooms } : {})
    },
    ...offerNodes,
    {
      "@type": "RealEstateAgent",
      "@id": organizationId,
      name: site.name,
      url: site.baseUrl,
      telephone: `+${site.whatsapp}`,
      image: new URL(site.logoHorizontal, site.baseUrl).toString()
    }
  ]
};
---

<BaseLayout
  title={`${property.seoTitle} | Amaru FS Inmobiliaria`}
  description={property.metaDescription}
  ogTitle={property.title}
  ogDescription={property.summary ?? property.metaDescription}
  ogImage={getSocialImageUrl(property.gallery[0].src)}
  activePage="inmuebles"
  breadcrumbs={[
    { name: "Inmuebles", path: "/inmuebles/" },
    { name: property.title, path: getPropertyHref(property) }
  ]}
  disableReveal
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(detailJsonLd)} />

  <main id="inicio">
    <section class="detail-hero">
      <div class="property-gallery" data-property-gallery>
        <figure class="property-gallery__stage">
          <img
            src={mainImage.mainSrc}
            srcset={mainImage.srcset}
            sizes={mainImage.srcset ? gallerySizes : undefined}
            alt={mainImage.alt}
            width="1440"
            height="1080"
            fetchpriority="high"
            decoding="async"
            data-gallery-main
          />
          <button class="property-gallery__zoom" type="button" aria-label="Ampliar foto actual" data-gallery-open>
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          </button>
          <div class="detail-hero__tags" aria-label="Información rápida del inmueble">
            <span><i class={isRent ? "fa-solid fa-door-open" : "fa-solid fa-sign-hanging"} aria-hidden="true"></i> {operationLabel}</span>
            <span><i class="fa-solid fa-building" aria-hidden="true"></i> {propertyTypeLabel}</span>
            <span><i class="fa-solid fa-camera" aria-hidden="true"></i> <b data-gallery-count>1 / {property.gallery.length}</b></span>
          </div>
        </figure>
        <div class="property-gallery__nav" aria-label="Fotos del inmueble">
          <button class="property-gallery__arrow" type="button" aria-label="Ver foto anterior" data-gallery-prev>
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
          </button>
          <div class="property-gallery__thumbs" role="list">
            {
              galleryImages.map((photo, index) => {
                const imageAlt = photo.alt;

                return (
                  <button
                    class:list={{ "property-gallery__thumb": true, "is-active": index === 0 }}
                    type="button"
                    aria-label={`Ver imagen ${index + 1} del inmueble`}
                    aria-current={index === 0 ? "true" : "false"}
                    data-gallery-thumb
                    data-gallery-src={photo.mainSrc}
                    data-gallery-srcset={photo.srcset}
                    data-gallery-modal-src={photo.modalSrc}
                    data-gallery-alt={imageAlt}
                  >
                    <img src={photo.thumbSrc} alt="" width="120" height="120" loading="lazy" decoding="async" />
                  </button>
                );
              })
            }
          </div>
          <button class="property-gallery__arrow" type="button" aria-label="Ver foto siguiente" data-gallery-next>
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
          </button>
        </div>
      </div>
    </section>

    <aside class="property-summary" aria-labelledby="property-title">
      <p class="eyebrow">Ficha del inmueble</p>
      <h1 id="property-title">{property.title}</h1>
      <dl class="summary-list">
        {property.internalCode && (
          <div>
            <dt>Código</dt>
            <dd>{property.internalCode}</dd>
          </div>
        )}
        <div>
          <dt>Ubicación</dt>
          <dd>{getPropertyLocationLabel(property)}</dd>
        </div>
        <div>
          <dt>Tipo</dt>
          <dd>{propertyTypeLabel} en {operationLabel.toLowerCase()}</dd>
        </div>
        {prices.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{formatCurrency(item.value)}{item.kind === "arriendo" && property.administrationIncluded ? " (administración incluida)" : ""}</dd>
          </div>
        ))}
      </dl>
      <div class="summary-actions">
        <Button variant="secondary" size="sm" icon="fa-brands fa-whatsapp" id="inmueble-consultar-disponibilidad" href={whatsappHref} external>Consultar disponibilidad</Button>
        <Button variant="ghost" size="sm" icon="fa-solid fa-phone" id="inmueble-llamar-asesor" href={`tel:+${site.whatsapp}`}>Llamar a un asesor</Button>
      </div>
      <p class="summary-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> Escríbenos con el código del inmueble y te confirmamos disponibilidad, condiciones y fecha de visita.</p>
    </aside>

    <section class="section-pad section-band section-band--white intro-block" aria-labelledby="intro-title">
      <SectionHeading eyebrow="Información principal" title={featuresTitle} titleId="intro-title" description={answerSummary} />
      <div class="quick-grid">
        {property.features.map((feature) => (
          <article>
            <i class={getFeatureIconClass(feature.icon)} aria-hidden="true"></i>
            <span>{feature.label}</span>
          </article>
        ))}
      </div>
    </section>

    <section class="section-pad section-band section-band--gray description-section" aria-labelledby="description-title">
      <SectionHeading eyebrow="Descripción" title="Descripción del inmueble" titleId="description-title" />
      <div class="description-box">
        <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
        <div class="description-box__content" set:html={descriptionHtml}></div>
      </div>
    </section>

    <section class="section-pad section-band section-band--white location-layout" aria-labelledby="location-title">
      <div>
        <p class="eyebrow">Ubicación</p>
        <h2 id="location-title">Ubicación del inmueble</h2>
      </div>
      <div class="map-card" aria-label={`Ubicación general de ${property.title}`}>
        {mapsSrc ? (
          <iframe src={mapsSrc} width="600" height="450" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin" title={`Mapa de ${property.title}`}></iframe>
        ) : (
          <>
            <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
            <strong>{getPropertyLocationLabel(property)}</strong>
            <span>Mapa pendiente de validación</span>
          </>
        )}
      </div>
    </section>

    <section class="section-pad section-band section-band--white location-layout" aria-labelledby="nearby-title">
      <div>
        <p class="eyebrow">Zonas aledañas</p>
        <h2 id="nearby-title">Referencias cercanas</h2>
        <p>Puntos de referencia del sector para ubicar el inmueble.</p>
      </div>
      <ul class="nearby-list">
        {property.nearbyZones.map((zone) => (
          <li>
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
            <span>{zone}</span>
          </li>
        ))}
      </ul>
    </section>

    {youtubeSrc && (
      <section class="section-pad section-band section-band--gray location-layout" aria-labelledby="video-title">
        <div>
          <p class="eyebrow">Video</p>
          <h2 id="video-title">Video del inmueble</h2>
        </div>
        <div class="video-card">
          <iframe src={youtubeSrc} width="315" height="560" title={`Video de ${property.title}`} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="lazy"></iframe>
        </div>
      </section>
    )}

    <section class="process section-pad section-band section-band--white" aria-labelledby="rent-process-title">
      <SectionHeading eyebrow={`Proceso de ${operationLabel.toLowerCase()}`} title={processTitle} titleId="rent-process-title" />
      <ol class="timeline">
        {
          processSteps.map((step, index) => (
            <li>
              <span><i class={step.icon} aria-hidden="true"></i> {String(index + 1).padStart(2, "0")}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
              {step.modalId && (
                <button class="timeline__link" type="button" data-modal-open={step.modalId}>
                  {step.actionLabel} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </button>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section-pad section-band section-band--gray trust-grid" aria-labelledby="trust-title">
      <SectionHeading eyebrow="Confianza" title="Información verificada antes de avanzar" titleId="trust-title" description="Amaru FS Inmobiliaria trabaja con información real del inmueble, fotos autorizadas y características revisadas." />
      <div class="trust-cards">
        <article>
          <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
          <h3>Acompañamiento directo</h3>
          <p>Te orientamos por WhatsApp o llamada para resolver dudas antes de avanzar.</p>
        </article>
        <article>
          <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
          <h3>Información clara</h3>
          <p>Publicamos precio, ubicación, características y material visual cuando están verificados.</p>
        </article>
        <article>
          <i class="fa-solid fa-scale-balanced" aria-hidden="true"></i>
          <h3>Proceso responsable</h3>
          <p>{isDual ? "En arriendo, la aseguradora realiza el estudio de viabilidad del interesado y su deudor. En venta, las condiciones se validan con las partes antes de avanzar con documentos o visitas." : isRent ? "En arriendo, la aseguradora realiza el estudio de viabilidad del interesado y su deudor." : "En venta, las condiciones se validan con las partes antes de avanzar con documentos o visitas."}</p>
        </article>
      </div>
    </section>

    <ClosingCta
      title="¿Te interesa este inmueble?"
      text={`Escríbenos y te indicamos el siguiente paso para ${isDual ? "tomarlo en arriendo o presentar tu oferta de compra" : isRent ? "tomarlo en arriendo" : "visitarlo y presentar tu oferta"}.`}
      variant="flat"
      class="section-band section-band--white"
    >
      <Button variant="secondary" icon="fa-brands fa-whatsapp" id="inmueble-consultar-por-whatsapp" href={whatsappHref} external>Consultar por WhatsApp</Button>
    </ClosingCta>

    <FaqSection title="Preguntas frecuentes sobre este inmueble" items={faqItems} class="section-band section-band--gray" />

    {relatedProperties.length > 0 && (
      <section class="related section-pad section-band section-band--white" aria-labelledby="related-title">
        <SectionHeading eyebrow="Más opciones" title="Otros inmuebles que te pueden interesar" titleId="related-title" />
        <ul class="related-grid">
          {relatedProperties.map((item) => (
            <li class="related-card">
              <img
                src={getCroppedImageUrl(item.gallery[0].src, 480)}
                alt=""
                width="480"
                height="360"
                loading="lazy"
                decoding="async"
              />
              <div class="related-card__body">
                <span class="related-card__meta">{getOperationLabel(item.operation)} · {getPropertyTypeLabel(item.propertyType)}</span>
                <h3><a href={getPropertyHref(item)}>{item.title}</a></h3>
                <p><i class="fa-solid fa-location-dot" aria-hidden="true"></i> {getPropertyLocationLabel(item)}</p>
                <strong>{formatCurrency(getPropertyPrice(item))}</strong>
              </div>
            </li>
          ))}
        </ul>
        <a class="related__all" href="/inmuebles/">Ver todos los inmuebles <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      </section>
    )}
  </main>

  <div class="mobile-cta" role="region" aria-label="Contacto rápido sobre este inmueble">
    <div class="mobile-cta__price">
      <span>{priceLabel}{isRent ? " mensual" : ""}</span>
      <strong>{formattedPrice.replace(/\s*COP$/, "")}</strong>
    </div>
    <a id="inmueble-barra-movil-whatsapp" class="mobile-cta__whatsapp" href={whatsappHref} target="_blank" rel="noopener noreferrer">
      <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> WhatsApp
    </a>
    <a id="inmueble-barra-movil-llamar" class="mobile-cta__call" href={`tel:+${site.whatsapp}`} aria-label="Llamar a un asesor">
      <i class="fa-solid fa-phone" aria-hidden="true"></i>
    </a>
  </div>

  {isRent && <RentalRequirementsModal id="detail-requirements-modal" />}

  {!isRent && (
    <dialog class="advisor-modal" id="sale-requirements-modal" aria-labelledby="sale-requirements-modal-title" data-modal>
      <div class="advisor-modal__card">
        <button class="advisor-modal__close" type="button" aria-label="Cerrar requisitos" data-modal-close>
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
        <i class="fa-solid fa-user-tie" aria-hidden="true"></i>
        <p class="eyebrow">Requisitos</p>
        <h2 id="sale-requirements-modal-title">Valida los requisitos con tu asesor</h2>
        <p>Para avanzar con la compra de este inmueble, confirma directamente con tu asesor de Amaru FS Inmobiliaria los documentos, condiciones comerciales y pasos necesarios según el caso.</p>
        <Button variant="secondary" icon="fa-brands fa-whatsapp" href={whatsappHref} external>Hablar con asesor</Button>
      </div>
    </dialog>
  )}

  <div class="gallery-modal" role="dialog" aria-modal="true" aria-label="Foto ampliada del inmueble" hidden data-gallery-modal>
    <button class="gallery-modal__close" type="button" aria-label="Cerrar galería" data-gallery-close>
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>
    <button class="gallery-modal__arrow gallery-modal__arrow--prev" type="button" aria-label="Ver foto anterior" data-modal-prev>
      <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
    </button>
    <figure class="gallery-modal__stage">
      <img data-src={mainImage.modalSrc} alt={mainImage.alt} decoding="async" data-gallery-modal-image />
      <figcaption data-modal-count>1 / {property.gallery.length}</figcaption>
    </figure>
    <button class="gallery-modal__arrow gallery-modal__arrow--next" type="button" aria-label="Ver foto siguiente" data-modal-next>
      <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
    </button>
  </div>

  <script>
    import "../../scripts/detalle-inmueble.js";
  </script>
</BaseLayout>
