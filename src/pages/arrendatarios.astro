---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProcessPhases, { type ProcessPhase } from "../components/sections/ProcessPhases.astro";
import ClosingCta from "../components/sections/ClosingCta.astro";
import PageHero from "../components/sections/PageHero.astro";
import FaqSection, { type FaqItem } from "../components/sections/FaqSection.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import RentalRequirementsModal from "../components/common/RentalRequirementsModal.astro";
import "../styles/pages/arrendatarios.css";

const faqItems: FaqItem[] = [
  {
    question: "¿Amaru FS Inmobiliaria aprueba mi solicitud de arriendo?",
    answer: "No. Amaru FS Inmobiliaria acompaña la información inicial y la coordinación del proceso. La aseguradora realiza el estudio de viabilidad del interesado y su deudor."
  },
  {
    question: "¿Puedo pedir fotos o videos antes de avanzar?",
    answer: "Sí. Por página web, WhatsApp o llamada se pueden compartir fotos, videos y características disponibles del inmueble."
  },
  {
    question: "¿Qué pasa después de revisar los requisitos?",
    answer: "Si decides continuar, se avanza al estudio de viabilidad con la aseguradora. Si el interesado y su deudor son aprobados, se genera el contrato de arrendamiento con las cláusulas correspondientes."
  },
  {
    question: "¿El inmueble siempre estará disponible?",
    answer: "La disponibilidad debe confirmarse, porque puede cambiar según visitas, solicitudes y avances del proceso."
  },
  {
    question: "¿De qué depende el valor del estudio con la aseguradora?",
    answer: "El valor del estudio depende del canon de arrendamiento del inmueble. Ese valor es definido y cobrado directamente por la aseguradora."
  }
];

const processPhases: ProcessPhase[] = [
  {
    label: "Fase 1",
    title: "Búsqueda",
    steps: [
      {
        icon: "fa-solid fa-magnifying-glass",
        title: "Elige un inmueble disponible",
        text: "Revisa las características, fotos, ubicación y precio publicado.",
        action: {
          label: "Ver inmuebles disponibles",
          href: "/inmuebles/",
          id: "fase-1-arrendatarios-ver-inmuebles"
        }
      },
      {
        icon: "fa-brands fa-whatsapp",
        title: "Escríbenos por WhatsApp",
        text: "Indica cuál inmueble te interesa para confirmar disponibilidad y resolver dudas.",
        action: {
          label: "Escribir por WhatsApp",
          href: "https://wa.me/573158774545?text=Hola%20Amaru%20FS%2C%20me%20interesa%20un%20inmueble%20en%20arriendo.%20Quiero%20confirmar%20disponibilidad%20y%20recibir%20m%C3%A1s%20informaci%C3%B3n.",
          id: "fase-1-arrendatarios-escribir-whatsapp"
        }
      }
    ]
  },
  {
    label: "Fase 2",
    title: "Revisión",
    steps: [
      {
        icon: "fa-solid fa-images",
        title: "Recibe información adicional",
        text: "Te compartimos características, fotos, videos y datos disponibles para que evalúes si quieres continuar."
      },
      {
        icon: "fa-solid fa-clipboard-list",
        title: "Revisa requisitos",
        text: "Si sigues interesado, te compartimos los requisitos necesarios para iniciar el proceso con la aseguradora.",
        action: {
          label: "Ver requisitos",
          modalId: "requirements-modal",
          id: "fase-2-arrendatarios-ver-requisitos"
        }
      }
    ]
  },
  {
    label: "Fase 3",
    title: "Aprobación",
    steps: [
      {
        icon: "fa-solid fa-shield-halved",
        title: "Estudio de aseguradora",
        text: "La aseguradora, no Amaru FS Inmobiliaria, realiza el estudio de viabilidad del interesado y su deudor."
      },
      {
        icon: "fa-solid fa-file-signature",
        title: "Contrato de arrendamiento",
        text: "Una vez el interesado y su deudor son aprobados por la aseguradora, se genera el contrato de arrendamiento con las cláusulas correspondientes."
      }
    ]
  }
];
---

<BaseLayout
  title="Arrendatarios | Consulta inmuebles en arriendo con Amaru FS Inmobiliaria"
  description="Consulta inmuebles en arriendo con Amaru FS Inmobiliaria. Recibe características, fotos, videos y requisitos. La aseguradora realiza el estudio de viabilidad y, si el proceso es aprobado, se genera el contrato de arrendamiento."
  ogTitle="Arrendatarios Amaru FS Inmobiliaria"
  ogDescription="Información clara para consultar inmuebles en arriendo y avanzar con requisitos."
  ogImage="/images/Arrendatarios.webp"
  activePage="arrendatarios"
  breadcrumbs={[{ name: "Arrendatarios", path: "/arrendatarios/" }]}
>
  <main id="inicio">
    <PageHero
      eyebrow="Arrendatarios en Bogotá y Sabana"
      title="Encuentra inmuebles en arriendo con información clara y atención directa"
      lead="Si te interesa un inmueble publicado por Amaru FS Inmobiliaria, te compartimos características, fotos, videos y requisitos. Cuando el proceso avanza, la aseguradora realiza el estudio de viabilidad del interesado y su deudor. Una vez aprobados, generamos el contrato de arrendamiento."
      backgroundImage="/images/banner-arrendatario.webp"
      panel={{
        image: "/images/banner-arrendatario-lateral.webp",
        icon: "fa-solid fa-circle-info",
        title: "Antes de avanzar, revisa información real del inmueble",
        text: "Te orientamos con datos claros: canon, ubicación, características, fotos, videos, disponibilidad y requisitos antes de avanzar con aseguradora."
      }}
    >
      <Fragment slot="actions">
        <Button variant="secondary" icon="fa-solid fa-building" id="arrendatarios-ver-inmuebles" href="https://wa.me/573158774545?text=Hola%20Amaru%20FS%2C%20quiero%20ver%20inmuebles%20disponibles%20en%20arriendo." external>Ver inmuebles disponibles</Button>
        <Button variant="light" icon="fa-solid fa-arrow-down" id="arrendatarios-mas-informacion" href="#informacion">Más información</Button>
      </Fragment>
    </PageHero>

    <section class="process section-pad" id="proceso" aria-labelledby="process-title">
      <SectionHeading eyebrow="Paso a paso" title="Cómo avanzar si te interesa un inmueble" titleId="process-title" />
      <ProcessPhases phases={processPhases} columns={2} />
    </section>

    <section class="questions section-pad" id="informacion" aria-labelledby="questions-title">
      <div class="questions__content">
        <p class="eyebrow">Qué puedes preguntar</p>
        <h2 id="questions-title">Información útil antes de visitar o aplicar</h2>
        <p>Esta información te ayuda a decidir si el inmueble se ajusta a lo que buscas antes de coordinar visita o avanzar con requisitos.</p>
      </div>
      <div class="questions__groups">
        <article class="question-group">
          <div class="question-group__heading">
            <span>01</span>
            <i class="fa-solid fa-house-circle-check" aria-hidden="true"></i>
            <h3>Inmueble</h3>
          </div>
          <p>Datos básicos para revisar si la propiedad realmente se ajusta a lo que necesitas.</p>
          <ul>
            <li>Disponibilidad actual del inmueble.</li>
            <li>Ubicación y referencias del sector.</li>
            <li>Fotos y videos disponibles.</li>
          </ul>
        </article>
        <article class="question-group">
          <div class="question-group__heading">
            <span>02</span>
            <i class="fa-solid fa-file-invoice-dollar" aria-hidden="true"></i>
            <h3>Valor</h3>
          </div>
          <p>Información económica para entender el canon y los costos asociados antes de avanzar.</p>
          <ul>
            <li>Precio o canon de arriendo.</li>
            <li>Valor de administración, si aplica.</li>
          </ul>
        </article>
        <article class="question-group">
          <div class="question-group__heading">
            <span>03</span>
            <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
            <h3>Agenda y requisitos</h3>
          </div>
          <p>Condiciones prácticas para visitar, aplicar y continuar con el estudio de aseguradora.</p>
          <ul>
            <li>Condiciones de visita.</li>
            <li>Requisitos generales para iniciar el proceso.</li>
            <li>Siguiente paso con aseguradora.</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="roles section-pad" aria-labelledby="roles-title">
      <SectionHeading eyebrow="Roles del proceso" title="Quién hace qué en el proceso de arriendo" titleId="roles-title" />
      <div class="role-grid">
        <article>
          <i class="fa-solid fa-house-user" aria-hidden="true"></i>
          <h3>Amaru FS Inmobiliaria</h3>
          <p>Atiende tu interés inicial, comparte características, fotos, videos y requisitos del inmueble, orienta los pasos comerciales y coordina el avance hacia el estudio de aseguradora.</p>
        </article>
        <article>
          <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
          <h3>Aseguradora</h3>
          <p>Realiza el estudio de viabilidad del interesado y su deudor. Ese estudio es independiente del acompañamiento comercial de Amaru FS Inmobiliaria y define si el proceso puede avanzar a contrato.</p>
        </article>
      </div>
    </section>

    <section class="trust section-pad" aria-labelledby="trust-title">
      <div class="trust__box">
        <p class="eyebrow">Antes de aplicar</p>
        <h2 id="trust-title">Decide con información completa</h2>
        <p>Antes de iniciar con los requisitos, te ayudamos a revisar si el inmueble se ajusta a lo que buscas: canon, ubicación, fotos, videos, disponibilidad, condiciones de visita y pasos con aseguradora. Si algún dato necesita confirmación, lo validamos contigo antes de avanzar.</p>
      </div>
    </section>

    <ClosingCta
      title="¿Ya viste un inmueble que te interesa?"
      text="Escríbenos por WhatsApp con el nombre o enlace del inmueble. Confirmamos información disponible, te compartimos requisitos y te indicamos el paso siguiente para avanzar con aseguradora."
    >
      <Button variant="secondary" icon="fa-solid fa-building" id="arrendatarios-ver-inmuebles-iniciar" href="/inmuebles/">Ver inmuebles disponibles</Button>
    </ClosingCta>

    <FaqSection title="Preguntas frecuentes de arrendatarios" items={faqItems} />

    <RentalRequirementsModal />
  </main>
</BaseLayout>
