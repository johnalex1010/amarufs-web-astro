---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pages/referidos.css";
---

<BaseLayout
  title="Referidos Amaru FS Inmobiliaria | Recomienda propietarios o interesados"
  description="Conoce el programa de referidos de Amaru FS Inmobiliaria. Recomienda propietarios con inmuebles para venta o arriendo, o personas interesadas en comprar o arrendar, y participa por recompensa cuando haya cierre."
  ogTitle="Programa de referidos Amaru FS Inmobiliaria"
  ogDescription="Recomienda propietarios o interesados reales en Bogotá y Sabana. La recompensa aplica cuando el negocio cierre según reglas internas."
  robots="noindex, nofollow"
  activePage="referidos"
>
  <Fragment slot="head">
    <script type="application/ld+json">
      {
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [
              { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "index.html" },
              { "@type": "ListItem", "position": 2, "name": "Referidos", "item": "referidos.html" }
            ]
          }
    </script>
    <script type="application/ld+json">
      {
            "@context": "https://schema.org",
            "@type": "Service",
            "name": "Programa de referidos inmobiliarios Amaru FS Inmobiliaria",
            "provider": {
              "@type": "RealEstateAgent",
              "name": "Amaru FS Inmobiliaria"
            },
            "areaServed": ["Bogotá", "Sabana"],
            "description": "Programa para referir propietarios con inmuebles para venta o arriendo, y personas interesadas en comprar o arrendar. La recompensa aplica por cierre documentado según reglas internas."
          }
    </script>
    <script type="application/ld+json">
      {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "¿Qué se considera un referido válido?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Un referido válido puede ser un propietario o contacto autorizado con un inmueble para venta o arriendo, o una persona interesada en comprar o arrendar un inmueble. En ambos casos debe existir autorización de contacto y datos mínimos verificables."
                }
              },
              {
                "@type": "Question",
                "name": "¿Cuándo se paga la recompensa?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "La recompensa aplica únicamente cuando el referido termina en un negocio cerrado y documentado por Amaru FS Inmobiliaria, según las reglas internas del programa."
                }
              },
              {
                "@type": "Question",
                "name": "¿Hay un valor definido de recompensa?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Para arriendo, la recompensa es del 8% sobre el canon mensual y se paga una sola vez. Para venta, es el 8% sobre la comisión inmobiliaria, calculada como el 3% del valor de venta."
                }
              },
              {
                "@type": "Question",
                "name": "¿Qué pasa si dos personas refieren el mismo contacto?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Se reconoce el primer registro verificable, según la trazabilidad de Amaru FS Inmobiliaria."
                }
              },
              {
                "@type": "Question",
                "name": "¿Puedo referir a alguien que quiere comprar o arrendar?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Sí. También puedes referir personas que buscan comprar o tomar en arriendo un inmueble, siempre que el contacto sea real y haya autorizado ser contactado."
                }
              }
            ]
          }
    </script>
  </Fragment>

  <main id="inicio">
    <section class="hero">
      <div class="hero__content">
        <p class="eyebrow">Referidos inmobiliarios</p>
        <h1>Refiere propietarios o interesados y participa por recompensa de cierre</h1>
        <p class="hero__lead">Si conoces a alguien que quiere vender o arrendar su inmueble, o a una persona que busca comprar o tomar en arriendo, puedes conectarlo con Amaru FS Inmobiliaria. Si el referido es válido y el negocio se cierra con nosotros, puedes recibir una recompensa según las reglas del programa.</p>
        <div class="hero__actions" aria-label="Acciones principales">
          <a class="btn btn--primary"
            href="#simulator-title"><i class="fa-solid fa-handshake-angle" aria-hidden="true"></i> Quiero
            referir ahora</a>
          <a class="btn btn--light" href="#valid-title"><i class="fa-solid fa-list-check" aria-hidden="true"></i> Ver reglas
            del programa</a>
        </div>
      </div>
      <aside class="hero__panel" aria-labelledby="hero-panel-title">
        <img src="/images/banner-referidos-lateral.webp" alt="Amaru FS Inmobiliaria" width="216" height="216">
        <span class="hero__panel-icon" aria-hidden="true"><i class="fa-solid fa-people-arrows"></i></span>
        <h2 id="hero-panel-title">Tu contacto puede convertirse en una oportunidad real</h2>
        <p>Recibimos referidos reales, con datos verificables y autorización para contactar al propietario o al interesado. La recompensa aplica únicamente por cierre documentado.</p>
      </aside>
    </section>

    <section class="valid-referrals section-pad" aria-labelledby="valid-title">
      <div class="section-heading">
        <p class="eyebrow">A quién puedes referir</p>
        <h2 id="valid-title">Referidos válidos para Amaru FS Inmobiliaria</h2>
        <p>Puedes referir propietarios con inmuebles para venta o arriendo, y también personas que buscan comprar o tomar en arriendo. El enfoque inicial está en Bogotá y Sabana, según viabilidad comercial y validación interna.</p>
      </div>
      <div class="referral-grid">
        <article class="referral-card">
          <i class="fa-solid fa-sign-hanging" aria-hidden="true"></i>
          <h3>Propietarios que quieren vender</h3>
        </article>
        <article class="referral-card">
          <i class="fa-solid fa-door-open" aria-hidden="true"></i>
          <h3>Propietarios que quieren arrendar</h3>
        </article>
        <article class="referral-card">
          <i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>
          <h3>Personas que quieren comprar</h3>
        </article>
        <article class="referral-card">
          <i class="fa-solid fa-user-check" aria-hidden="true"></i>
          <h3>Personas que buscan arrendar</h3>
        </article>
        <article class="referral-card referral-card--accent">
          <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
          <h3>Aliados locales que conocen oportunidades reales</h3>
        </article>
      </div>
    </section>

    <section class="process section-pad" id="proceso" aria-labelledby="process-title">
      <div class="section-heading">
        <p class="eyebrow">Cómo funciona</p>
        <h2 id="process-title">Proceso del programa de referidos</h2>
      </div>
      <ol class="timeline">
        <li>
          <span><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> 01</span>
          <h3>Envías el referido</h3>
          <p>Compartes los datos mínimos del propietario, interesado, inmueble o búsqueda por WhatsApp.</p>
        </li>
        <li>
          <span><i class="fa-solid fa-clipboard-check" aria-hidden="true"></i> 02</span>
          <h3>Validamos la información</h3>
          <p>Revisamos si el contacto es real, si autorizó ser contactado y si la oportunidad puede avanzar.</p>
        </li>
        <li>
          <span><i class="fa-solid fa-comments" aria-hidden="true"></i> 03</span>
          <h3>Inicia el proceso comercial</h3>
          <p>Contactamos al propietario o interesado, aclaramos dudas y definimos el siguiente paso.</p>
        </li>
        <li>
          <span><i class="fa-solid fa-file-signature" aria-hidden="true"></i> 04</span>
          <h3>Se gestiona la oportunidad</h3>
          <p>Si aplica, se publica el inmueble, se agenda visita o se avanza con requisitos y condiciones.</p>
        </li>
        <li>
          <span><i class="fa-solid fa-hand-holding-heart" aria-hidden="true"></i> 05</span>
          <h3>La recompensa aplica por cierre</h3>
          <p>Se reconoce únicamente cuando el negocio se cierra y queda documentado según las reglas internas.</p>
        </li>
      </ol>
    </section>

    <section class="checklist section-pad" aria-labelledby="data-title">
      <div class="section-heading">
        <p class="eyebrow">Datos mínimos</p>
        <h2 id="data-title">Qué información necesitamos</h2>
        <p>Para conservar trazabilidad, el registro debe separar quién refiere, quién es el contacto referido y cuál es la oportunidad inmobiliaria.</p>
      </div>
      <div class="info-phases">
        <article class="info-phase">
          <div class="info-phase__heading">
            <span>Fase 1</span>
            <h3>Referente</h3>
          </div>
          <ol class="info-timeline">
            <li>
              <span><i class="fa-solid fa-id-card" aria-hidden="true"></i> 01</span>
              <h4>Nombre completo</h4>
              <p>Identifica al referente y permite dejar trazabilidad del registro.</p>
            </li>
            <li>
              <span><i class="fa-solid fa-address-book" aria-hidden="true"></i> 02</span>
              <h4>Correo y teléfono</h4>
              <p>Correo electrónico y teléfono del referente para confirmar el registro.</p>
            </li>
          </ol>
        </article>

        <article class="info-phase">
          <div class="info-phase__heading">
            <span>Fase 2</span>
            <h3>Referido</h3>
          </div>
          <ol class="info-timeline" start="3">
            <li>
              <span><i class="fa-solid fa-user-check" aria-hidden="true"></i> 03</span>
              <h4>Datos del contacto</h4>
              <p>Nombre completo, número celular y correo electrónico de la persona referida.</p>
            </li>
            <li>
              <span><i class="fa-solid fa-users-viewfinder" aria-hidden="true"></i> 04</span>
              <h4>Tipo de referido</h4>
              <p>Define si el contacto es propietario, vendedor o persona interesada.</p>
            </li>
          </ol>
        </article>

        <article class="info-phase info-phase--closing">
          <div class="info-phase__heading">
            <span>Fase 3</span>
            <h3>Oportunidad</h3>
          </div>
          <ol class="info-timeline" start="5">
            <li>
              <span><i class="fa-solid fa-bullseye" aria-hidden="true"></i> 05</span>
              <h4>Intención y ubicación</h4>
              <p>Indica si quiere vender, arrendar, comprar o tomar en arriendo, junto con ciudad y sector.</p>
            </li>
            <li>
              <span><i class="fa-solid fa-circle-check" aria-hidden="true"></i> 06</span>
              <h4>Autorización</h4>
              <p>Confirma que la persona referida autorizó ser contactada para revisar la oportunidad.</p>
            </li>
          </ol>
        </article>
      </div>
    </section>

    <section class="simulator section-pad" aria-labelledby="simulator-title">
      <div class="section-heading">
        <p class="eyebrow">Tarifas de negociación</p>
        <h2 id="simulator-title">Registra tu referido y estima la recompensa</h2>
        <p>Este espacio deja listo el flujo de inscripción y permite calcular un valor estimado según el tipo de oportunidad. La recompensa final aplica solo cuando el negocio se cierra con Amaru FS Inmobiliaria y queda documentado.</p>
      </div>
      <div class="simulator__layout">
        <article class="referral-intake" aria-labelledby="intake-title">
          <p class="eyebrow">Inscripción del referido</p>
          <h3 id="intake-title">Datos para iniciar el registro</h3>
          <p class="referral-intake__intro">Base inicial para registrar el contacto antes de conectar el envío real.</p>
          <form class="intake-wizard" data-intake-wizard aria-label="Formulario paso a paso para referidos" novalidate>
            <div class="intake-progress" role="tablist" aria-label="Pasos del registro">
              <button type="button" class="is-active" role="tab" aria-selected="true" aria-controls="intake-step-referrer" data-intake-tab="0">Referente</button>
              <button type="button" role="tab" aria-selected="false" aria-controls="intake-step-referred" data-intake-tab="1">Referido</button>
              <button type="button" role="tab" aria-selected="false" aria-controls="intake-step-conversion" data-intake-tab="2">Oportunidad</button>
              <button type="button" role="tab" aria-selected="false" aria-controls="intake-step-summary" data-intake-tab="3">Resumen</button>
            </div>
            <div class="intake-step is-active" id="intake-step-referrer" role="tabpanel" data-intake-step="0">
              <p class="intake-step__meta">Paso 1 de 4</p>
              <h4>Datos del referente</h4>
              <div class="intake-fields">
                <label>Nombre completo <input type="text" name="referenteNombre" placeholder="Nombre de quien refiere" autocomplete="name" data-validation="name" required></label>
                <label>Correo electrónico <input type="email" name="referenteCorreo" placeholder="Correo del referente" autocomplete="email" data-validation="email" required></label>
                <label>WhatsApp <input type="tel" name="referenteTelefono" placeholder="WhatsApp del referente" autocomplete="tel" inputmode="numeric" maxlength="10" data-validation="phone" required></label>
              </div>
            </div>
            <div class="intake-step" id="intake-step-referred" role="tabpanel" hidden data-intake-step="1">
              <p class="intake-step__meta">Paso 2 de 4</p>
              <h4>Datos del referido</h4>
              <div class="intake-fields">
                <label>Nombre completo <input type="text" name="referidoNombre" placeholder="Nombre de la persona referida" data-validation="name" required></label>
                <label>Correo electrónico <input type="email" name="referidoCorreo" placeholder="Correo del referido" data-validation="email" required></label>
                <label>WhatsApp <input type="tel" name="referidoWhatsapp" placeholder="WhatsApp del contacto" inputmode="numeric" maxlength="10" data-validation="phone" required></label>
                <label>Tipo de referido
                  <select name="tipoReferido" data-validation="select" required>
                    <option value="">Selecciona una opción</option>
                    <option>Propietario</option>
                    <option>Arrendatario</option>
                  </select>
                </label>
              </div>
            </div>
            <div class="intake-step" id="intake-step-conversion" role="tabpanel" hidden data-intake-step="2">
              <p class="intake-step__meta">Paso 3 de 4</p>
              <h4>Oportunidad inmobiliaria</h4>
              <div class="intake-fields">
                <label>¿Cuál es su intención?
                  <select name="intencion" data-validation="select" required>
                    <option value="">Selecciona una opción</option>
                    <option>Vender</option>
                    <option>Arrendar</option>
                    <option>Comprar</option>
                    <option>Tomar en arriendo</option>
                  </select>
                </label>
                <label>Ciudad <input type="text" name="ciudad" placeholder="Ej: Bogotá" data-validation="text" required></label>
                <label>Sector <input type="text" name="sector" placeholder="Ej: Alcalá Sur" data-validation="text" required></label>
              </div>
            </div>
            <div class="intake-step" id="intake-step-summary" role="tabpanel" hidden data-intake-step="3">
              <p class="intake-step__meta">Paso 4 de 4</p>
              <h4>Resumen del registro</h4>
              <div class="intake-fields">
                <div class="intake-summary" aria-labelledby="intake-summary-title">
                  <div class="intake-summary__heading">
                    <span>Resumen</span>
                    <h5 id="intake-summary-title">Información que se enviará</h5>
                  </div>
                  <dl>
                    <div><dt>Referente</dt><dd data-intake-summary="referenteNombre">[dato pendiente]</dd></div>
                    <div><dt>Correo referente</dt><dd data-intake-summary="referenteCorreo">[dato pendiente]</dd></div>
                    <div><dt>WhatsApp referente</dt><dd data-intake-summary="referenteTelefono">[dato pendiente]</dd></div>
                    <div><dt>Referido</dt><dd data-intake-summary="referidoNombre">[dato pendiente]</dd></div>
                    <div><dt>Correo referido</dt><dd data-intake-summary="referidoCorreo">[dato pendiente]</dd></div>
                    <div><dt>WhatsApp referido</dt><dd data-intake-summary="referidoWhatsapp">[dato pendiente]</dd></div>
                    <div><dt>Tipo de referido</dt><dd data-intake-summary="tipoReferido">[dato pendiente]</dd></div>
                    <div><dt>Intención</dt><dd data-intake-summary="intencion">[dato pendiente]</dd></div>
                    <div><dt>Ciudad</dt><dd data-intake-summary="ciudad">[dato pendiente]</dd></div>
                    <div><dt>Sector</dt><dd data-intake-summary="sector">[dato pendiente]</dd></div>
                  </dl>
                </div>
                <div class="intake-consent-group" aria-label="Autorizaciones del referido">
                  <label class="intake-check"><input type="checkbox" name="autorizaContacto" data-validation="checkbox" required><span>Confirmo autorización para contactar al referido.</span></label>
                  <label class="intake-check"><input type="checkbox" name="aceptaDatos" data-validation="checkbox" required><span>Acepto el tratamiento de datos personales. <a href="">ver más</a></span></label>
                </div>
              </div>
            </div>
            <div class="intake-actions">
              <button type="button" class="btn btn--ghost" data-intake-prev disabled>Anterior</button>
              <button type="button" class="btn btn--secondary" data-intake-next>Siguiente</button>
            </div>
            <p class="intake-status" data-intake-status aria-live="polite"></p>
          </form>
        </article>

        <article class="simulator-panel" aria-labelledby="simulator-panel-title">
          <div class="simulator-panel__top">
            <div>
              <p class="eyebrow">Calcula antes de enviar</p>
              <h3 id="simulator-panel-title">Calcula la recompensa</h3>
            </div>
            <span class="simulator-panel__badge">Estimado</span>
          </div>
          <div class="simulator-tabs" role="tablist" aria-label="Tipo de negociación para simular">
            <button type="button" class="is-active" id="tab-rent" role="tab" aria-selected="true" aria-controls="panel-rent" data-simulator-tab="rent">
              <i class="fa-solid fa-key" aria-hidden="true"></i> Arriendo
            </button>
            <button type="button" id="tab-sale" role="tab" aria-selected="false" aria-controls="panel-sale" data-simulator-tab="sale">
              <i class="fa-solid fa-sign-hanging" aria-hidden="true"></i> Venta
            </button>
          </div>
          <div class="simulator-card is-active" id="panel-rent" role="tabpanel" aria-labelledby="tab-rent" data-referral-simulator="rent">
            <h4>8% sobre el canon mensual</h4>
            <p class="simulator-card__note">Pago único sobre el canon mensual. No se liquida mes a mes.</p>
            <div class="simulator-detail">
              <span>Base de cálculo</span>
              <strong>Canon mensual informado</strong>
            </div>
            <label for="rent-canon">Canon mensual</label>
            <input id="rent-canon" type="text" inputmode="numeric" autocomplete="off" placeholder="Ej: 1000000" data-referral-input>
            <div class="simulator-result" aria-live="polite">
              <span>Recompensa estimada</span>
              <strong data-referral-result>$0 COP</strong>
            </div>
          </div>
          <div class="simulator-card" id="panel-sale" role="tabpanel" aria-labelledby="tab-sale" hidden data-referral-simulator="sale">
            <h4>8% sobre la comisión</h4>
            <p class="simulator-card__note">La comisión inmobiliaria se estima como el 3% del valor de venta.</p>
            <label for="sale-value">Valor de venta</label>
            <input id="sale-value" type="text" inputmode="numeric" autocomplete="off" placeholder="Ej: 100000000" data-referral-input>
            <div class="simulator-result" aria-live="polite">
              <span>Recompensa estimada</span>
              <strong data-referral-result>$0 COP</strong>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="faq section-pad" aria-labelledby="faq-title">
      <div class="section-heading">
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-title">Preguntas frecuentes sobre referidos</h2>
      </div>
      <div class="faq-list" data-faq-list>
        <article class="faq-item">
          <button type="button" aria-expanded="false">
            <span>¿Qué se considera un referido válido?</span>
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
          </button>
          <div class="faq-item__body">
            <p>Un propietario o contacto autorizado con un inmueble para venta o arriendo, o una persona interesada en comprar o arrendar. El contacto debe ser real, verificable y haber autorizado ser contactado.</p>
          </div>
        </article>
        <article class="faq-item">
          <button type="button" aria-expanded="false">
            <span>¿Cuándo se paga la recompensa?</span>
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
          </button>
          <div class="faq-item__body">
            <p>La recompensa aplica únicamente cuando el referido termina en un negocio cerrado y documentado por Amaru
              FS Inmobiliaria, según las reglas internas del programa.</p>
          </div>
        </article>
        <article class="faq-item">
          <button type="button" aria-expanded="false">
            <span>¿Hay un valor definido de recompensa?</span>
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
          </button>
          <div class="faq-item__body">
            <p>Para arriendo, la recompensa es del 8% sobre el canon mensual y se paga una sola vez. Para venta, se calcula el 8% sobre la comisión inmobiliaria, que se estima como el 3% del valor de venta.</p>
          </div>
        </article>
        <article class="faq-item">
          <button type="button" aria-expanded="false">
            <span>¿Qué pasa si dos personas refieren el mismo contacto?</span>
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
          </button>
          <div class="faq-item__body">
            <p>Se reconoce el primer registro verificable, según la trazabilidad de Amaru FS Inmobiliaria.</p>
          </div>
        </article>
        <article class="faq-item">
          <button type="button" aria-expanded="false">
            <span>¿Puedo referir a alguien que quiere comprar o arrendar?</span>
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
          </button>
          <div class="faq-item__body">
            <p>Sí. Puedes referir personas que buscan comprar o tomar en arriendo un inmueble, siempre que el contacto sea válido y autorizado.</p>
          </div>
        </article>
      </div>
    </section>

  </main>

  <script>
    const numberFormatter = new Intl.NumberFormat("es-CO", {
      maximumFractionDigits: 0,
    });

    const cleanCurrencyValue = (value) => {
      const numericValue = Number(String(value).replace(/[^\d]/g, ""));
      return Number.isFinite(numericValue) ? numericValue : 0;
    };

    const formatCurrency = (value) => `$ ${numberFormatter.format(value)} COP`;

    const GOOGLE_APPS_SCRIPT_URL = "";

    document.querySelectorAll("[data-intake-wizard]").forEach((wizard) => {
      const tabs = Array.from(wizard.querySelectorAll("[data-intake-tab]"));
      const steps = Array.from(wizard.querySelectorAll("[data-intake-step]"));
      const previousButton = wizard.querySelector("[data-intake-prev]");
      const nextButton = wizard.querySelector("[data-intake-next]");
      const statusMessage = wizard.querySelector("[data-intake-status]");
      const fields = Array.from(wizard.querySelectorAll("input, select"));
      const summaryItems = Array.from(wizard.querySelectorAll("[data-intake-summary]"));
      const namePattern = /^[A-Za-zÁÉÍÓÚÜÑáéíóúüñ]+(?:[ '-][A-Za-zÁÉÍÓÚÜÑáéíóúüñ]+)*$/;
      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
      const phonePattern = /^\d{10}$/;
      let activeStep = 0;
      let isSubmitting = false;

      const setStatus = (message = "", type = "") => {
        if (!statusMessage) {
          return;
        }

        statusMessage.textContent = message;
        statusMessage.classList.remove("is-loading", "is-success", "is-error");

        if (type) {
          statusMessage.classList.add(`is-${type}`);
        }
      };

      const getErrorMessage = (field) => {
        const value = field instanceof HTMLInputElement && field.type === "checkbox" ? field.checked : field.value.trim();
        const validationType = field.getAttribute("data-validation");

        if (validationType === "checkbox") {
          return value ? "" : "Debes confirmar esta autorización.";
        }

        if (!value) {
          return "Este campo es obligatorio.";
        }

        if (validationType === "name" && !namePattern.test(String(value))) {
          return "Ingresa solo letras y espacios.";
        }

        if (validationType === "text" && String(value).length < 2) {
          return "Ingresa mínimo 2 caracteres.";
        }

        if (validationType === "email" && !emailPattern.test(String(value))) {
          return "Ingresa un correo electrónico válido.";
        }

        if (validationType === "phone" && !phonePattern.test(String(value))) {
          return "Ingresa solo números, exactamente 10 dígitos.";
        }

        if (validationType === "select" && !field.value) {
          return "Selecciona una opción.";
        }

        return "";
      };

      const getFieldContainer = (field) => field.closest(".intake-check") || field.closest("label");

      const getErrorElement = (field) => {
        const container = getFieldContainer(field);

        if (!container) {
          return null;
        }

        let errorElement = container.querySelector(".field-error");

        if (!errorElement) {
          errorElement = document.createElement("p");
          errorElement.className = "field-error";
          errorElement.id = `${field.name || "campo"}-error`;
          container.appendChild(errorElement);
        }

        return errorElement;
      };

      const validateField = (field, shouldShowError = true) => {
        const errorMessage = getErrorMessage(field);

        if (!shouldShowError) {
          return !errorMessage;
        }

        const errorElement = getErrorElement(field);
        const container = getFieldContainer(field);

        if (errorElement) {
          errorElement.textContent = errorMessage;
        }

        field.classList.toggle("is-invalid", Boolean(errorMessage));
        field.classList.toggle("is-valid", !errorMessage && (field instanceof HTMLInputElement && field.type === "checkbox" ? field.checked : field.value.trim() !== ""));
        field.setAttribute("aria-invalid", String(Boolean(errorMessage)));

        if (container) {
          container.classList.toggle("is-invalid", Boolean(errorMessage));
        }

        if (errorElement) {
          field.toggleAttribute("aria-describedby", Boolean(errorMessage));
          if (errorMessage) {
            field.setAttribute("aria-describedby", errorElement.id);
          }
        }

        return !errorMessage;
      };

      const validateStep = (stepIndex, shouldShowError = true) => {
        const step = steps[stepIndex];
        const stepFields = Array.from(step.querySelectorAll("input, select"));

        return stepFields
          .map((field) => validateField(field, shouldShowError))
          .every(Boolean);
      };

      const validateForm = (shouldShowError = false) => fields
        .map((field) => validateField(field, shouldShowError))
        .every(Boolean);

      const updateSummary = () => {
        summaryItems.forEach((item) => {
          const fieldName = item.getAttribute("data-intake-summary");
          const field = fieldName ? wizard.elements.namedItem(fieldName) : null;

          if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement) {
            item.textContent = field.value.trim() || "[dato pendiente]";
          }
        });
      };

      const updateButtons = () => {
        const isLastStep = activeStep === steps.length - 1;
        const isFormValid = validateForm(false);

        if (previousButton instanceof HTMLButtonElement) {
          previousButton.disabled = activeStep === 0 || isSubmitting;
        }

        if (nextButton instanceof HTMLButtonElement) {
          nextButton.textContent = isLastStep ? "Enviar referido" : "Siguiente";
          nextButton.disabled = isSubmitting || (isLastStep && !isFormValid);
        }
      };

      const showStep = (stepIndex) => {
        activeStep = Math.max(0, Math.min(stepIndex, steps.length - 1));

        tabs.forEach((tab, index) => {
          const isActive = index === activeStep;
          tab.classList.toggle("is-active", isActive);
          tab.classList.toggle("is-complete", index < activeStep);
          tab.setAttribute("aria-selected", String(isActive));
        });

        steps.forEach((step, index) => {
          const isActive = index === activeStep;
          step.classList.toggle("is-active", isActive);
          step.toggleAttribute("hidden", !isActive);
        });

        updateSummary();
        updateButtons();
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => {
          if (index <= activeStep) {
            showStep(index);
            return;
          }

          const canMoveForward = steps
            .slice(0, index)
            .every((_, stepIndex) => validateStep(stepIndex, true));

          if (canMoveForward) {
            showStep(index);
          } else {
            setStatus("Completa los campos obligatorios antes de avanzar.", "error");
          }
        });
      });

      previousButton?.addEventListener("click", () => showStep(activeStep - 1));

      nextButton?.addEventListener("click", async () => {
        setStatus("");

        if (activeStep < steps.length - 1) {
          if (validateStep(activeStep, true)) {
            showStep(activeStep + 1);
          } else {
            setStatus("Revisa los campos marcados antes de continuar.", "error");
          }

          return;
        }

        if (!validateForm(true)) {
          setStatus("Revisa los campos marcados antes de finalizar.", "error");
          updateButtons();
          return;
        }

        const formData = new FormData(wizard);
        const payload = Object.fromEntries(formData.entries());
        isSubmitting = true;
        updateButtons();
        setStatus("Cargando información...", "loading");

        try {
          if (GOOGLE_APPS_SCRIPT_URL) {
            await fetch(GOOGLE_APPS_SCRIPT_URL, {
              method: "POST",
              mode: "no-cors",
              headers: {
                "Content-Type": "text/plain;charset=utf-8",
              },
              body: JSON.stringify({
                ...payload,
                fechaRegistro: new Date().toISOString(),
                origen: "web-amarufs-referidos",
              }),
            });
          } else {
            await new Promise((resolve) => {
              window.setTimeout(resolve, 900);
            });
          }

          setStatus("Tu registro fue exitoso. Pronto nos comunicaremos contigo para dar seguimiento al proceso.", "success");
        } catch {
          setStatus("No pudimos registrar la información. Inténtalo de nuevo o comunícate por WhatsApp.", "error");
        } finally {
          isSubmitting = false;
          updateButtons();
        }
      });

      fields.forEach((field) => {
        field.addEventListener("input", () => {
          if (field.getAttribute("data-validation") === "phone" && field instanceof HTMLInputElement) {
            field.value = field.value.replace(/\D/g, "").slice(0, 10);
          }

          updateSummary();
          validateField(field, true);
          setStatus("");
          updateButtons();
        });

        field.addEventListener("blur", () => {
          updateSummary();
          validateField(field, true);
          updateButtons();
        });

        field.addEventListener("change", () => {
          updateSummary();
          validateField(field, true);
          setStatus("");
          updateButtons();
        });
      });

      updateSummary();
      showStep(0);
    });

    const simulatorTabs = document.querySelectorAll("[data-simulator-tab]");

    simulatorTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const selectedType = tab.getAttribute("data-simulator-tab");

        simulatorTabs.forEach((currentTab) => {
          const isSelected = currentTab === tab;
          currentTab.classList.toggle("is-active", isSelected);
          currentTab.setAttribute("aria-selected", String(isSelected));
        });

        document.querySelectorAll("[data-referral-simulator]").forEach((panel) => {
          const isSelected = panel.getAttribute("data-referral-simulator") === selectedType;
          panel.classList.toggle("is-active", isSelected);
          panel.toggleAttribute("hidden", !isSelected);
        });
      });
    });

    document.querySelectorAll("[data-referral-simulator]").forEach((simulator) => {
      const input = simulator.querySelector("[data-referral-input]");
      const result = simulator.querySelector("[data-referral-result]");

      if (!(input instanceof HTMLInputElement) || !result) {
        return;
      }

      const simulatorType = simulator.getAttribute("data-referral-simulator");

      const updateSimulator = () => {
        const baseValue = cleanCurrencyValue(input.value);
        const realEstateCommission = simulatorType === "sale" ? baseValue * 0.03 : 0;
        const reward = simulatorType === "sale" ? realEstateCommission * 0.08 : baseValue * 0.08;

        input.value = baseValue > 0 ? numberFormatter.format(baseValue) : "";

        result.textContent = formatCurrency(reward);
      };

      input.addEventListener("input", updateSimulator);
      input.addEventListener("blur", updateSimulator);
    });
  </script>
</BaseLayout>
