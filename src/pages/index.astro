---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqSection, { type FaqItem } from "../components/sections/FaqSection.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import "../styles/pages/home.css";

const faqItems: FaqItem[] = [
  {
    question: "¿Amaru FS Inmobiliaria publica directamente mi inmueble?",
    answer: "Sí, pero solo después de validar el inmueble, registrar fotos y videos, verificar la ficha técnica y formalizar el contrato con el propietario."
  },
  {
    question: "¿Dónde trabaja Amaru FS Inmobiliaria?",
    answer: "El enfoque inicial está en Bogotá y Sabana, según disponibilidad, viabilidad comercial y validación interna del inmueble."
  },
  {
    question: "¿Cómo contacto a Amaru FS Inmobiliaria?",
    answer: "El canal principal es WhatsApp 315 877 4545, porque permite resolver dudas, compartir información del inmueble y coordinar pasos con rapidez.",
    answerHtml: "El canal principal es WhatsApp <a href=\"https://wa.me/573158774545\" target=\"_blank\" rel=\"noopener noreferrer\">315 877 4545</a>, porque permite resolver dudas, compartir información del inmueble y coordinar pasos con rapidez."
  },
  {
    question: "¿Qué pasa si quiero tomar un inmueble en arriendo?",
    answer: "Amaru FS Inmobiliaria comparte información, fotos, videos y requisitos. La aseguradora realiza el estudio de viabilidad del interesado y su deudor."
  }
];
---

<BaseLayout
  title="Amaru FS Inmobiliaria | Arriendo y venta de inmuebles en Bogotá y Sabana"
  description="Arrienda, vende o encuentra inmuebles con Amaru FS Inmobiliaria. Acompañamiento directo, fotos reales, ficha clara, seguimiento por WhatsApp y proceso validado en Bogotá y Sabana."
  ogTitle="Amaru FS Inmobiliaria en Bogotá y Sabana"
  ogDescription="Inmuebles reales, atención directa y acompañamiento para propietarios y arrendatarios."
  ogImage="/images/home.webp"
  activePage="inicio"
>
  <Fragment slot="head">
    <script type="application/ld+json">
      {
            "@context": "https://schema.org",
            "@type": "RealEstateAgent",
            "@id": "https://www.amarufs.co/#real-estate-agent",
            "name": "Amaru FS Inmobiliaria",
            "description": "Inmobiliaria en Bogotá y Sabana que acompaña procesos de arriendo, venta y publicación de inmuebles con información validada.",
            "areaServed": ["Bogotá", "Tocancipá", "Villavicencio", "Mesitas del Colegio"],
            "telephone": "+57 315 877 4545",
            "url": "https://www.amarufs.co/",
            "logo": "https://www.amarufs.co/images/logo-horizontal-fondo-blanco.png",
            "image": "https://www.amarufs.co/images/logo-horizontal-fondo-blanco.png",
            "priceRange": "$$",
            "sameAs": []
          }
    </script>
  </Fragment>

  <main id="inicio">
    <section class="hero">
      <div class="hero__content">
        <p class="eyebrow">Inmobiliaria en Bogotá y Sabana</p>
        <h1>Arrienda o vende tu inmueble con acompañamiento directo en Bogotá y Sabana</h1>
        <p class="hero__lead">En Amaru FS Inmobiliaria ayudamos a propietarios, arrendatarios y compradores con
          información clara, fotos reales, seguimiento por WhatsApp y un proceso pensado para generar confianza desde el
          primer contacto.</p>
        <div class="hero__actions" aria-label="Acciones principales">
          <Button variant="secondary" icon="fa-brands fa-whatsapp" id="home-validar-whatsapp" href="https://wa.me/573158774545?text=Hola%20Amaru%20FS%2C%20quiero%20validar%20mi%20inmueble." external>Quiero validar mi inmueble</Button>
          <Button variant="light" icon="fa-solid fa-building" id="home-ver-inmuebles" href="/inmuebles/">Ver inmuebles disponibles</Button>
        </div>
      </div>
      <aside class="hero__panel" aria-labelledby="hero-panel-title">
        <img src="/images/home-banner.webp" alt="Amaru FS Inmobiliaria" width="216" height="216">
        <span class="hero__panel-icon" aria-hidden="true"><i class="fa-solid fa-shield-halved"></i></span>
        <h2 id="hero-panel-title">Inmuebles reales, proceso claro y contacto directo</h2>
        <p>Si tienes un inmueble para arrendar o vender, comunícate con nosotros y revisamos tu caso, visitamos la propiedad, verificamos la ficha
          técnica y publicamos.</p>
      </aside>
    </section>

    <section class="intro section-pad" aria-labelledby="intro-title">
      <SectionHeading eyebrow="Atención directa y cercana" title="Un proceso claro para cada intención inmobiliaria" titleId="intro-title" />
      <div class="intro__grid">
        <p><i class="fa-solid fa-key" aria-hidden="true"></i> Si buscas vivienda o una oportunidad de compra, te
          compartimos información del inmueble disponible y te orientamos antes de avanzar.</p>
        <p><i class="fa-solid fa-clipboard-check" aria-hidden="true"></i> Si quieres publicar tu inmueble, coordinamos
          los pasos necesarios para validar información, material visual, condiciones y contrato.</p>
      </div>
    </section>

    <section class="routes section-pad" id="rutas" aria-labelledby="routes-title">
      <SectionHeading eyebrow="Rutas principales" title="¿Qué necesitas hacer hoy?" titleId="routes-title" />
      <div class="card-grid">
        <article class="route-card">
          <img src="/images/banner-propietario-lateral.webp" alt="Asesoría para propietarios que quieren vender o arrendar un inmueble" width="720" height="420" loading="lazy">
          <div class="route-card__body">
            <span class="route-card__icon" aria-hidden="true"><i class="fa-solid fa-house"></i></span>
            <h3>Propietarios</h3>
            <p>Tienes un inmueble para vender o arrendar. Te explicamos el proceso, validamos la información
              y publicamos la propiedad.</p>
            <a id="home-propietarios" href="/propietarios/">Soy propietario <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
          </div>
        </article>
        <article class="route-card">
          <img src="/images/banner-propietario-arriendo-lateral.webp" alt="Información para arrendatarios interesados en inmuebles disponibles" width="720" height="420" loading="lazy">
          <div class="route-card__body">
            <span class="route-card__icon" aria-hidden="true"><i class="fa-solid fa-door-open"></i></span>
            <h3>Arrendatarios</h3>
            <p>Estás interesado en un inmueble disponible. Te compartimos características, fotos, videos y requisitos. </p>
            <a id="home-arrendatarios" href="/arrendatarios/">Busco inmueble en arriendo <i class="fa-solid fa-arrow-right"
                aria-hidden="true"></i></a>
          </div>
        </article>
      </div>
    </section>

    <section class="properties section-pad" id="inmuebles" aria-labelledby="properties-title">
      <div class="properties__content">
        <p class="eyebrow">Inmuebles disponibles</p>
        <h2 id="properties-title">Propiedades disponibles para visitar, arrendar o comprar</h2>
        <p>Consulta inmuebles reales con información de precio, ubicación, características, fotos y disponibilidad. Si
          alguno te interesa, escríbenos por WhatsApp para confirmar detalles y avanzar al siguiente paso.</p>
        <Button variant="primary" icon="fa-solid fa-list-check" id="home-ver-inmuebles" href="https://wa.me/573158774545?text=Hola%20Amaru%20FS%2C%20quiero%20consultar%20inmuebles%20disponibles." external>Ver todos los inmuebles</Button>
      </div>
      <div class="properties__visual" style="background-image: linear-gradient(180deg, rgba(11, 34, 83, 0.16), rgba(11, 34, 83, 0.48)), url('/images/fotos-reales.webp');" aria-label="Espacio editorial con fotografía real de inmueble">
        <div class="property-window">
          <span><i class="fa-solid fa-image" aria-hidden="true"></i></span>
          <strong>¿Arrendar o vender?</strong>
          <p>Déjalo en nuestras manos. Evaluamos tu propiedad, realizamos la visita, validamos su información y nos encargamos de publicarla para encontrar al cliente adecuado.</p>
        </div>
      </div>
    </section>

    <section class="trust section-pad" aria-labelledby="trust-title">
      <div class="trust__box">
        <p class="eyebrow">Confianza sin prometer de más</p>
        <h2 id="trust-title">Una inmobiliaria cercana, clara y enfocada en resultados</h2>
        <p>Amaru FS Inmobiliaria está construyendo una cartera inmobiliaria con base en confianza, atención directa y
          contenido verificable. No competimos por prometer volumen: trabajamos para que cada inmueble publicado tenga
          información útil y seguimiento comercial.</p>
      </div>
    </section>

    <FaqSection title="Preguntas frecuentes sobre Amaru FS Inmobiliaria" items={faqItems} />
  </main>
</BaseLayout>
