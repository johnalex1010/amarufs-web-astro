---
import BaseLayout from "../layouts/BaseLayout.astro";
import Timeline, { type TimelineStep } from "../components/sections/Timeline.astro";
import ClosingCta from "../components/sections/ClosingCta.astro";
import PageHero from "../components/sections/PageHero.astro";
import FaqSection, { type FaqItem } from "../components/sections/FaqSection.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import "../styles/pages/propietarios.css";

const faqItems: FaqItem[] = [
  {
    question: "¿El propietario publica directamente su inmueble?",
    answer: "No. Amaru FS Inmobiliaria publica el inmueble después de validar información, registrar fotos y videos, verificar la ficha técnica y formalizar el contrato con el propietario."
  },
  {
    question: "¿Puedo vender y arrendar con Amaru FS Inmobiliaria?",
    answer: "Sí. La página ofrece rutas claras para venta y arriendo, según el objetivo del propietario."
  },
  {
    question: "¿Qué necesita Amaru FS Inmobiliaria antes de publicar?",
    answer: "Necesita conocer el inmueble, resolver dudas, visitarlo, registrar material visual, verificar la ficha técnica y formalizar el contrato correspondiente."
  },
  {
    question: "¿Amaru FS Inmobiliaria garantiza el cierre?",
    answer: "No. Amaru FS Inmobiliaria ofrece acompañamiento, publicación clara y seguimiento comercial, pero no garantiza resultados ni cierres."
  }
];

const processSteps: TimelineStep[] = [
  {
    icon: "fa-brands fa-whatsapp",
    title: "Contacto inicial",
    text: "Nos escribes por WhatsApp o llamas con el tipo de inmueble, ciudad o sector y objetivo: venta o arriendo."
  },
  {
    icon: "fa-solid fa-comments",
    title: "Llamada o reunión",
    text: "Aclaramos dudas sobre el proceso, alcance, información requerida y siguiente paso."
  },
  {
    icon: "fa-solid fa-camera",
    title: "Visita al inmueble",
    text: "Amaru FS Inmobiliaria se acerca al inmueble para registrar fotos, videos y verificar datos de la ficha técnica."
  },
  {
    icon: "fa-solid fa-file-signature",
    title: "Formalización",
    text: "Cuando el caso avanza, se realiza el contrato entre propietario e inmobiliaria según el servicio acordado."
  },
  {
    icon: "fa-solid fa-bullhorn",
    title: "Publicación por Amaru FS",
    text: "La inmobiliaria publica el inmueble con las características verificadas y hace seguimiento comercial a los interesados."
  }
];
---

<BaseLayout
  title="Propietarios | Vende o arrienda tu inmueble con Amaru FS Inmobiliaria"
  description="¿Tienes un inmueble para vender o arrendar? Amaru FS Inmobiliaria valida, registra fotos y videos, verifica la ficha técnica y publica después del contrato."
  ogTitle="Propietarios Amaru FS Inmobiliaria"
  ogDescription="Acompañamiento para vender, arrendar o administrar inmuebles en Bogotá y Sabana."
  ogImage="/images/propietarios.webp"
  activePage="propietarios"
  breadcrumbs={[{ name: "Propietarios", path: "/propietarios/" }]}
>
  <main id="inicio">
    <PageHero
      eyebrow="Propietarios en Bogotá y Sabana"
      title="Vende o arrienda tu inmueble con acompañamiento inmobiliario"
      lead="En Amaru FS Inmobiliaria te orientamos desde el primer contacto: resolvemos dudas, visitamos el inmueble, registramos fotos y videos, verificamos la ficha técnica y publicamos después de formalizar el contrato con la inmobiliaria."
      backgroundImage="/images/banner-amarufs-propietarios.webp"
      panel={{
        image: "/images/banner-propietario-lateral.webp",
        icon: "fa-solid fa-camera-retro",
        title: "Tu inmueble necesita información clara, fotos reales y seguimiento",
        text: "Organizamos la información, validamos características y acompañamos la publicación para que cada interesado entienda precio, ubicación, condiciones y siguiente paso."
      }}
    >
      <Fragment slot="actions">
        <Button variant="secondary" icon="fa-brands fa-whatsapp" id="propietarios-whatsapp" href="https://wa.me/573158774545?text=Hola%20Amaru%20FS%2C%20quiero%20hablar%20sobre%20mi%20inmueble." external>Quiero hablar con Amaru FS Inmobiliaria</Button>
        <Button variant="light" icon="fa-solid fa-arrow-down" id="propietarios-conocer-proceso" href="#proceso">Conocer el proceso</Button>
      </Fragment>
    </PageHero>

    <section class="audience section-pad" aria-labelledby="audience-title">
      <SectionHeading eyebrow="Ruta para propietarios" title="Esta ruta es para propietarios con un inmueble real" titleId="audience-title" />
      <div class="audience__layout">
        <div class="audience__box">
          <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
          <p>Te podemos orientar si tienes un apartamento, casa, local u otro inmueble que quieras vender o arrendar en
            Bogotá o Sabana. Antes de publicar, necesitamos conocer el caso, revisar condiciones y confirmar que la
            información sea clara para los interesados.</p>
        </div>
        <div class="audience__summary" aria-label="Condiciones iniciales para propietarios">
          <article>
            <i class="fa-solid fa-building" aria-hidden="true"></i>
            <span>Inmueble real</span>
          </article>
          <article>
            <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
            <span>Bogotá o Sabana</span>
          </article>
          <article>
            <i class="fa-solid fa-clipboard-check" aria-hidden="true"></i>
            <span>Información verificable</span>
          </article>
        </div>
      </div>
    </section>

    <section class="services section-pad" id="servicios" aria-labelledby="services-title">
      <SectionHeading eyebrow="Servicios para propietarios" title="Elige el objetivo de tu inmueble" titleId="services-title" />
      <div class="service-grid">
        <article class="service-card">
          <span class="service-card__icon" aria-hidden="true"><i class="fa-solid fa-sign-hanging"></i></span>
          <h3>Vender mi inmueble</h3>
          <p>Te acompañamos en la preparación comercial del inmueble: validación inicial, visita, fotos, video, ficha
            técnica y publicación posterior al contrato con Amaru FS Inmobiliaria.</p>
          <a id="propietarios-vender" href="/propietarios/venta/">Quiero vender <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </article>
        <article class="service-card">
          <span class="service-card__icon" aria-hidden="true"><i class="fa-solid fa-door-open"></i></span>
          <h3>Arrendar mi inmueble</h3>
          <p>Organizamos la publicación para atraer interesados con información verificable. En el proceso de arriendo,
            la aseguradora realiza el estudio de viabilidad del interesado y su deudor.</p>
          <a id="propietarios-arrendar" href="/propietarios/arriendo/">Quiero arrendar <i class="fa-solid fa-arrow-right"
              aria-hidden="true"></i></a>
        </article>
      </div>
    </section>

    <section class="process section-pad" id="proceso" aria-labelledby="process-title">
      <SectionHeading eyebrow="Paso a paso" title="Cómo trabaja Amaru FS Inmobiliaria con propietarios" titleId="process-title" />
      <Timeline steps={processSteps} />
    </section>

    <section class="checklist section-pad" aria-labelledby="checklist-title">
      <div class="checklist__content">
        <p class="eyebrow">Antes de publicar</p>
        <h2 id="checklist-title">Antes de publicar, revisamos 3 frentes</h2>
        <p>Mientras más clara sea la información del inmueble, más fácil será orientar a los interesados y avanzar con
          conversaciones serias.</p>
      </div>
      <div class="checklist__groups">
        <article class="checklist-group">
          <div class="checklist-group__heading">
            <span>01</span>
            <i class="fa-solid fa-house-circle-check" aria-hidden="true"></i>
            <h3>Inmueble</h3>
          </div>
          <p>Datos básicos para entender qué inmueble se va a publicar y cómo debe presentarse.</p>
          <ul>
            <li>Tipo de inmueble.</li>
            <li>Ciudad, sector y referencias de ubicación.</li>
            <li>Área, habitaciones, baños y parqueadero.</li>
            <li>Estado del inmueble.</li>
          </ul>
        </article>
        <article class="checklist-group">
          <div class="checklist-group__heading">
            <span>02</span>
            <i class="fa-solid fa-file-invoice-dollar" aria-hidden="true"></i>
            <h3>Valor</h3>
          </div>
          <p>Información comercial para orientar el precio o canon y los costos asociados.</p>
          <ul>
            <li>Precio esperado o canon de arriendo.</li>
            <li>Administración, si aplica.</li>
          </ul>
        </article>
        <article class="checklist-group">
          <div class="checklist-group__heading">
            <span>03</span>
            <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
            <h3>Agenda y soporte</h3>
          </div>
          <p>Condiciones prácticas para coordinar visitas, material visual y siguientes pasos.</p>
          <ul>
            <li>Disponibilidad para visita.</li>
            <li>Fotos y videos reales.</li>
            <li>Documentos o condiciones necesarias.</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="transparency section-pad" aria-labelledby="transparency-title">
      <div class="transparency__box">
        <p class="eyebrow">Transparencia desde el inicio</p>
        <h2 id="transparency-title">Qué no promete Amaru FS Inmobiliaria</h2>
        <p>Amaru FS Inmobiliaria no promete cierres inmediatos, compradores garantizados ni una cartera más amplia de la
          real. Nuestro compromiso es trabajar con información verificable, publicación clara, acompañamiento directo y
          seguimiento comercial.</p>
      </div>
    </section>

    <ClosingCta
      title="¿Tienes un inmueble para vender o arrendar?"
      text="Cuéntanos qué tipo de inmueble tienes, dónde está ubicado y cuál es tu objetivo. Revisamos tu caso y te indicamos el siguiente paso."
    >
      <Button variant="secondary" icon="fa-brands fa-whatsapp" id="propietarios-iniciar-validacion" href="https://wa.me/573158774545?text=Hola%20Amaru%20FS%2C%20quiero%20iniciar%20la%20validaci%C3%B3n%20de%20mi%20inmueble." external>Iniciar validación por WhatsApp</Button>
    </ClosingCta>

    <FaqSection title="Preguntas frecuentes de propietarios" items={faqItems} />
  </main>
</BaseLayout>
