---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ClosingCta from "../../components/sections/ClosingCta.astro";
import PageHero from "../../components/sections/PageHero.astro";
import FaqSection, { type FaqItem } from "../../components/sections/FaqSection.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import Button from "../../components/ui/Button.astro";
import "../../styles/pages/propietarios-venta.css";

const faqItems: FaqItem[] = [
  {
    question: "¿Amaru FS Inmobiliaria publica mi inmueble en venta de inmediato?",
    answer: "No. Primero se revisa el caso, se visita el inmueble, se toman fotos y videos, se verifica la ficha técnica y se formaliza el contrato con el propietario."
  },
  {
    question: "¿El propietario publica el inmueble directamente?",
    answer: "No. La publicación la realiza Amaru FS Inmobiliaria después de validar el inmueble y formalizar el acuerdo correspondiente."
  },
  {
    question: "¿Qué porcentaje cobra la inmobiliaria por vender?",
    answer: "Amaru FS Inmobiliaria cobra el 3% sobre el valor de la venta. La comisión se calcula sobre el valor de venta y se paga al finalizar el proceso de venta."
  },
  {
    question: "¿Amaru FS Inmobiliaria garantiza la venta?",
    answer: "No. Amaru FS Inmobiliaria acompaña la publicación y el seguimiento comercial, pero no promete cierres garantizados."
  },
  {
    question: "¿Dónde trabaja Amaru FS Inmobiliaria la venta de inmuebles?",
    answer: "El enfoque inicial está en Bogotá y Sabana, sujeto a validación interna y viabilidad comercial del inmueble."
  }
];
---

<BaseLayout
  title="Vende tu inmueble con Amaru FS Inmobiliaria | Propietarios en Bogotá y Sabana"
  description="Vende tu inmueble con acompañamiento de Amaru FS Inmobiliaria. Validamos la propiedad, publicamos después del contrato y acompañamos la gestión comercial hasta el cierre."
  ogTitle="Vende tu inmueble con Amaru FS Inmobiliaria"
  ogDescription="Vende tu inmueble con acompañamiento de Amaru FS Inmobiliaria. Validamos la propiedad, registramos fotos y videos, verificamos la ficha técnica, publicamos después del contrato y acompañamos la gestión comercial hasta el cierre de venta."
  ogImage="/images/propietarios-venta.webp"
  activePage="propietarios-venta"
  breadcrumbs={[{ name: "Propietarios", path: "/propietarios/" }, { name: "Venta", path: "/propietarios/venta/" }]}
>
  <Fragment slot="head">
    <script type="application/ld+json">
      {
            "@context": "https://schema.org",
            "@type": "Service",
            "name": "Venta de inmuebles con acompañamiento inmobiliario",
            "provider": {
              "@type": "RealEstateAgent",
              "name": "Amaru FS Inmobiliaria"
            },
            "areaServed": ["Bogotá", "Sabana"],
            "serviceType": "Acompañamiento comercial para venta de inmuebles"
          }
    </script>
  </Fragment>

  <main id="inicio">
    <PageHero
      eyebrow="Propietarios vendedores en Bogotá y Sabana"
      title="Vende tu inmueble con acompañamiento inmobiliario en Bogotá y Sabana"
      lead="En Amaru FS Inmobiliaria te acompañamos desde la primera conversación hasta el cierre de venta del inmueble: aclaramos dudas, visitamos la propiedad, registramos fotos y videos, verificamos la ficha técnica, publicamos después del contrato con la inmobiliaria y damos seguimiento a la gestión comercial."
      backgroundImage="/images/banner-amarufs.webp"
      panel={{
        image: "/images/banner-propietario-venta-lateral.webp",
        icon: "fa-solid fa-sign-hanging",
        title: "Tu inmueble en venta necesita información clara y seguimiento comercial",
        text: "Organizamos la información comercial para que los interesados entiendan ubicación, características, precio, disponibilidad y siguiente paso de contacto."
      }}
    >
      <Fragment slot="actions">
        <Button variant="secondary" icon="fa-brands fa-whatsapp" id="propietarios-venta-quiero-vender" href="https://wa.me/573158774545?text=Hola%20Amaru%20FS%2C%20quiero%20vender%20mi%20inmueble." external>Quiero vender mi inmueble</Button>
        <Button variant="light" icon="fa-solid fa-arrow-down" id="propietarios-venta-conocer-proceso" href="#proceso">Conocer el proceso de venta</Button>
      </Fragment>
    </PageHero>

    <section class="audience section-pad" aria-labelledby="audience-title">
      <SectionHeading eyebrow="Ruta de venta" title="Esta ruta es para propietarios que quieren vender" titleId="audience-title" />
      <div class="audience__layout">
        <div class="audience__box">
          <i class="fa-solid fa-house-circle-check" aria-hidden="true"></i>
          <p>Esta página es para propietarios de apartamentos, casas, locales u otros inmuebles que quieren vender con una inmobiliaria que acompañe el proceso comercial. El enfoque inicial de Amaru FS Inmobiliaria está en Bogotá y Sabana, sujeto a validación del inmueble y viabilidad comercial.</p>
        </div>
        <div class="audience__summary" aria-label="Condiciones para vender con Amaru FS Inmobiliaria">
          <article>
            <i class="fa-solid fa-building" aria-hidden="true"></i>
            <span>Inmueble real</span>
          </article>
          <article>
            <i class="fa-solid fa-file-signature" aria-hidden="true"></i>
            <span>Contrato previo</span>
          </article>
          <article>
            <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
            <span>Publicación verificada</span>
          </article>
        </div>
      </div>
    </section>

    <section class="process section-pad" id="proceso" aria-labelledby="process-title">
      <SectionHeading eyebrow="Proceso de venta" title="Cómo vendemos tu inmueble" titleId="process-title" />
      <div class="process-phases">
        <article class="process-phase">
          <div class="process-phase__heading">
            <span>Fase 1</span>
            <h3>Preparación</h3>
          </div>
          <ol class="timeline timeline--sale">
            <li>
              <span><i class="fa-brands fa-whatsapp" aria-hidden="true"></i> 01</span>
              <h4>Contacto inicial</h4>
              <p>Nos escribes por WhatsApp o llamada y nos cuentas qué tipo de inmueble quieres vender, dónde está ubicado y cuál es tu objetivo.</p>
            </li>
            <li>
              <span><i class="fa-solid fa-comments" aria-hidden="true"></i> 02</span>
              <h4>Aclaración de dudas</h4>
              <p>Revisamos contigo el proceso, la información necesaria, las condiciones comerciales y los pasos antes de publicar.</p>
            </li>
            <li>
              <span><i class="fa-solid fa-camera" aria-hidden="true"></i> 03</span>
              <h4>Visita al inmueble</h4>
              <p>Amaru FS Inmobiliaria se acerca al inmueble para conocerlo, tomar fotos, grabar videos y validar características relevantes.</p>
            </li>
          </ol>
        </article>

        <article class="process-phase">
          <div class="process-phase__heading">
            <span>Fase 2</span>
            <h3>Publicación</h3>
          </div>
          <ol class="timeline timeline--sale" start="4">
            <li>
              <span><i class="fa-solid fa-clipboard-check" aria-hidden="true"></i> 04</span>
              <h4>Ficha técnica</h4>
              <p>Organizamos área, ubicación, distribución, estado, características, precio esperado, disponibilidad y condiciones de venta.</p>
            </li>
            <li>
              <span><i class="fa-solid fa-file-signature" aria-hidden="true"></i> 05</span>
              <h4>Contrato</h4>
              <p>Antes de publicar, debe existir un contrato formal entre el propietario y Amaru FS Inmobiliaria.</p>
            </li>
            <li>
              <span><i class="fa-solid fa-bullhorn" aria-hidden="true"></i> 06</span>
              <h4>Promoción</h4>
              <p>La inmobiliaria publica el inmueble con información verificada en web, redes, WhatsApp y piezas comerciales según disponibilidad.</p>
            </li>
          </ol>
        </article>

        <article class="process-phase process-phase--closing">
          <div class="process-phase__heading">
            <span>Fase 3</span>
            <h3>Cierre</h3>
          </div>
          <ol class="timeline timeline--sale" start="7">
            <li>
              <span><i class="fa-solid fa-handshake" aria-hidden="true"></i> 07</span>
              <h4>Interesados reales</h4>
              <p>Atendemos consultas, compartimos información del inmueble y coordinamos los siguientes pasos comerciales.</p>
            </li>
            <li>
              <span><i class="fa-solid fa-calendar-check" aria-hidden="true"></i> 08</span>
              <h4>Visitas y negociación</h4>
              <p>Coordinamos visitas con interesados calificados, resolvemos dudas comerciales y acompañamos la revisión de ofertas.</p>
            </li>
            <li>
              <span><i class="fa-solid fa-key" aria-hidden="true"></i> 09</span>
              <h4>Cierre de venta</h4>
              <p>Acompañamos el proceso comercial hasta el cierre de venta, según las condiciones pactadas entre las partes.</p>
            </li>
          </ol>
        </article>
      </div>
    </section>

    <section class="commission section-pad" aria-labelledby="commission-title">
      <div class="commission-summary">
        <div class="commission-summary__intro">
          <p class="eyebrow">Comisión inmobiliaria</p>
          <h2 id="commission-title">Comisión clara desde el inicio</h2>
          <p>La comisión queda explicada antes de avanzar y debe estar soportada en el acuerdo correspondiente con el propietario.</p>
        </div>
        <div class="commission-summary__rate" aria-label="Comisión de venta">
          <strong>3%</strong>
          <p>sobre el valor de la venta</p>
        </div>
        <dl class="commission-summary__details">
          <div>
            <dt>Base de cálculo</dt>
            <dd>Valor de la venta</dd>
          </div>
          <div>
            <dt>Momento de pago</dt>
            <dd>Al finalizar el proceso de venta</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="checklist section-pad" aria-labelledby="checklist-title">
      <div class="checklist__content">
        <p class="eyebrow">Antes de vender</p>
        <h2 id="checklist-title">Antes de publicar, revisamos 3 frentes</h2>
        <p>Esta información nos ayuda a validar el inmueble, preparar la ficha comercial y orientar mejor a los interesados desde el primer contacto.</p>
      </div>
      <div class="checklist__groups">
        <article class="checklist-group">
          <div class="checklist-group__heading">
            <span>01</span>
            <i class="fa-solid fa-house-circle-check" aria-hidden="true"></i>
            <h3>Inmueble</h3>
          </div>
          <p>Datos básicos para entender qué se va a vender y cómo debe presentarse.</p>
          <ul>
            <li>Tipo de inmueble.</li>
            <li>Ciudad, sector y referencias de ubicación.</li>
            <li>Área y distribución.</li>
            <li>Estado actual del inmueble.</li>
          </ul>
        </article>
        <article class="checklist-group">
          <div class="checklist-group__heading">
            <span>02</span>
            <i class="fa-solid fa-file-invoice-dollar" aria-hidden="true"></i>
            <h3>Valor</h3>
          </div>
          <p>Información comercial para explicar precio y costos asociados con claridad.</p>
          <ul>
            <li>Precio esperado de venta.</li>
            <li>Administración, si aplica.</li>
          </ul>
        </article>
        <article class="checklist-group">
          <div class="checklist-group__heading">
            <span>03</span>
            <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
            <h3>Agenda y soporte</h3>
          </div>
          <p>Condiciones prácticas para coordinar material, visitas y siguientes pasos.</p>
          <ul>
            <li>Disponibilidad para fotos, videos y visitas.</li>
            <li>Documentos o condiciones relevantes para avanzar.</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="deliverables section-pad" aria-labelledby="deliverables-title">
      <SectionHeading eyebrow="Acompañamiento comercial" title="Qué recibe el propietario" titleId="deliverables-title" />
      <div class="service-grid">
        <article class="service-card">
          <span class="service-card__icon" aria-hidden="true"><i class="fa-solid fa-clipboard-list"></i></span>
          <h3>Preparación del inmueble</h3>
          <p>Orientación inicial, visita al inmueble, registro visual y organización de ficha técnica para presentar la propiedad con información verificable.</p>
        </article>
        <article class="service-card">
          <span class="service-card__icon" aria-hidden="true"><i class="fa-solid fa-bullhorn"></i></span>
          <h3>Publicación y seguimiento</h3>
          <p>Publicación con información verificada, atención de interesados, coordinación de visitas, revisión comercial de ofertas y seguimiento hasta el cierre de venta.</p>
        </article>
      </div>
    </section>

    <section class="transparency section-pad" aria-labelledby="transparency-title">
      <div class="transparency__box">
        <p class="eyebrow">Transparencia antes de publicar</p>
        <h2 id="transparency-title">Qué no promete Amaru FS Inmobiliaria</h2>
        <p>Amaru FS Inmobiliaria no garantiza compradores, tiempos exactos de venta ni valorizaciones no verificadas. El compromiso es acompañar el proceso con información clara, publicación responsable, seguimiento comercial y comunicación directa.</p>
      </div>
    </section>

    <ClosingCta
      title="¿Quieres vender tu inmueble?"
      text="Cuéntanos dónde está ubicado, qué tipo de inmueble es y cuál es tu expectativa de venta. Revisamos el caso y te indicamos el siguiente paso."
    >
      <Button variant="secondary" icon="fa-brands fa-whatsapp" id="propietarios-venta-iniciar" href="https://wa.me/573158774545?text=Hola%20Amaru%20FS%2C%20quiero%20iniciar%20la%20venta%20de%20mi%20inmueble." external>Iniciar venta por WhatsApp</Button>
    </ClosingCta>

    <FaqSection title="Preguntas frecuentes sobre venta de inmuebles" items={faqItems} />
  </main>
</BaseLayout>
